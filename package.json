{
  "name": "reaharness",
  "version": "0.2.0",
  "description": "Clean multi-provider agent harness: MCP tools, OpenAI/Anthropic-compatible loop, idempotent host setup.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "reaharness": "bin/reaharness.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/architecture-guard.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "start": "node bin/reaharness.mjs mcp",
    "doctor": "node bin/reaharness.mjs doctor",
    "figures": "node website/figures/build-all.mjs",
    "site": "npx --yes serve website -l 4177"
  },
  "keywords": [
    "agents",
    "mcp",
    "model-context-protocol",
    "cli",
    "agent-harness",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunkshah12345-hash/reaharness.git"
  },
  "bugs": {
    "url": "https://github.com/arjunkshah12345-hash/reaharness/issues"
  },
  "homepage": "https://github.com/arjunkshah12345-hash/reaharness#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "playwright": "^1.64.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
